# dev tooling
.vscode/**
.vscode-test/**
.github/**
.firecrawl/**
.eslintrc.json
.editorconfig

# typescript sources — ship compiled out/ only
src/**
**/*.ts
!**/*.d.ts
**/tsconfig.json
**/*.map

# tests
test/**
tests/**
**/*.test.js

# misc
.gitignore
.gitattributes
.npmrc
.DS_Store
*.log
*.vsix

# icon source (only icon.png ships)
media/icon-source.svg

# node_modules — drop everything, then re-include only the runtime deps
# we actually require() at runtime (and their transitive deps, if any).
node_modules/**
!node_modules/ws/**
node_modules/ws/test/**
node_modules/ws/{.github,.husky,.vscode}/**
node_modules/ws/**/*.md
node_modules/ws/**/*.markdown
