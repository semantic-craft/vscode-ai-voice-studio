# dev tooling
.vscode/**
.vscode-test/**
.github/**
.firecrawl/**
.eslintrc.json
.editorconfig

# typescript sources — ship compiled out/ only
src/**
**/*.ts
!**/*.d.ts
**/tsconfig.json
**/*.map

# tests
test/**
tests/**
**/*.test.js

# misc
.gitignore
.gitattributes
.npmrc
.DS_Store
*.log
*.vsix

# icon source (only icon.png ships)
media/icon-source.svg

# node_modules — ship none (extension is zero-dep at runtime)
node_modules/**
