{
  "name": "ai-voice-studio",
  "displayName": "Qwen TTS Studio",
  "description": "Read text aloud in VS Code with Alibaba Cloud Qwen-TTS via DashScope.",
  "version": "0.7.0",
  "publisher": "xianwei-zhang",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xwzhangSZU/vscode-ai-voice-studio.git"
  },
  "bugs": {
    "url": "https://github.com/xwzhangSZU/vscode-ai-voice-studio/issues"
  },
  "homepage": "https://github.com/xwzhangSZU/vscode-ai-voice-studio#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tts",
    "text-to-speech",
    "speech",
    "voice",
    "qwen",
    "dashscope",
    "aliyun",
    "alibaba cloud"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:aiVoiceStudio.studio",
    "onCommand:aiVoiceStudio.quickRead",
    "onCommand:aiVoiceStudio.stop",
    "onCommand:aiVoiceStudio.setApiKey",
    "onCommand:aiVoiceStudio.clearApiKey",
    "onCommand:aiVoiceStudio.focusView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiVoiceStudio",
          "title": "Qwen TTS",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiVoiceStudio": [
        {
          "type": "webview",
          "id": "aiVoiceStudio.studio",
          "name": "Qwen TTS"
        }
      ]
    },
    "commands": [
      {
        "command": "aiVoiceStudio.quickRead",
        "title": "Read Selection (or Clipboard)",
        "category": "Qwen TTS Studio"
      },
      {
        "command": "aiVoiceStudio.stop",
        "title": "Stop Reading",
        "category": "Qwen TTS Studio"
      },
      {
        "command": "aiVoiceStudio.setApiKey",
        "title": "Set DashScope API Key...",
        "category": "Qwen TTS Studio"
      },
      {
        "command": "aiVoiceStudio.clearApiKey",
        "title": "Clear DashScope API Key",
        "category": "Qwen TTS Studio"
      },
      {
        "command": "aiVoiceStudio.focusView",
        "title": "Focus Qwen TTS Sidebar",
        "category": "Qwen TTS Studio"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aiVoiceStudio.quickRead",
          "when": "editorHasSelection",
          "group": "1_modification@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiVoiceStudio.quickRead",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "aiVoiceStudio.stop",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "Qwen TTS Studio",
      "properties": {
        "aiVoiceStudio.playbackRate": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4,
          "default": 1,
          "description": "Playback rate (0.5-4.0). Adjusts player speed without re-synthesis."
        },
        "aiVoiceStudio.chunkSize": {
          "type": "number",
          "minimum": 80,
          "maximum": 2000,
          "default": 250,
          "description": "Maximum characters per synthesis chunk. Long text is split at sentence boundaries; the next chunk synthesizes while the current one plays."
        },
        "aiVoiceStudio.qwen.model": {
          "type": "string",
          "enum": [
            "qwen3-tts-flash",
            "qwen3-tts-instruct-flash"
          ],
          "enumDescriptions": [
            "Qwen3 TTS Flash - current recommended non-realtime model.",
            "Qwen3 TTS Instruct Flash - sends style instructions."
          ],
          "default": "qwen3-tts-flash",
          "description": "Qwen-TTS model."
        },
        "aiVoiceStudio.qwen.voice": {
          "type": "string",
          "default": "Cherry",
          "description": "Default Qwen-TTS voice ID."
        },
        "aiVoiceStudio.qwen.endpoint": {
          "type": "string",
          "enum": ["china", "international"],
          "enumDescriptions": [
            "China endpoint: dashscope.aliyuncs.com.",
            "International endpoint: dashscope-intl.aliyuncs.com. Uses a region-specific API key."
          ],
          "default": "china",
          "description": "DashScope endpoint for Qwen-TTS."
        },
        "aiVoiceStudio.qwen.languageType": {
          "type": "string",
          "enum": ["Auto", "Chinese", "English", "German"],
          "default": "Auto",
          "description": "Qwen-TTS language_type. Choose a single language for better pronunciation, or Auto for mixed/unknown text."
        },
        "aiVoiceStudio.qwen.instructions": {
          "type": "string",
          "default": "",
          "description": "Style instructions sent only when model is qwen3-tts-instruct-flash."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.3"
  }
}
