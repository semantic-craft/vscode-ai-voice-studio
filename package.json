{
  "name": "ai-voice-studio",
  "displayName": "AI Voice Studio",
  "description": "Read text aloud in VS Code with MiniMax, MiMo, and OpenAI TTS — speed, voice, and style controls in the sidebar.",
  "version": "0.0.1",
  "publisher": "xianwei-zhang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tts",
    "text-to-speech",
    "speech",
    "voice",
    "minimax",
    "mimo",
    "openai"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiVoiceStudio",
          "title": "AI Voice Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiVoiceStudio": [
        {
          "type": "webview",
          "id": "aiVoiceStudio.studio",
          "name": "Voice Studio"
        }
      ]
    },
    "commands": [
      {
        "command": "aiVoiceStudio.helloWorld",
        "title": "AI Voice Studio: Hello World",
        "category": "AI Voice Studio"
      },
      {
        "command": "aiVoiceStudio.focusView",
        "title": "AI Voice Studio: Focus Sidebar",
        "category": "AI Voice Studio"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.3"
  }
}
