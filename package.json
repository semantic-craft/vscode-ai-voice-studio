{
  "name": "ai-voice-studio",
  "displayName": "AI Voice Studio",
  "description": "Read text aloud in VS Code with OpenAI, MiniMax, and MiMo TTS — speed, voice, and provider switching from the sidebar.",
  "version": "0.4.0",
  "publisher": "xianwei-zhang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tts",
    "text-to-speech",
    "speech",
    "voice",
    "openai",
    "minimax",
    "mimo"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiVoiceStudio",
          "title": "AI Voice Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiVoiceStudio": [
        {
          "type": "webview",
          "id": "aiVoiceStudio.studio",
          "name": "Voice Studio"
        }
      ]
    },
    "commands": [
      {
        "command": "aiVoiceStudio.quickRead",
        "title": "Read Selection (or Clipboard)",
        "category": "AI Voice Studio"
      },
      {
        "command": "aiVoiceStudio.stop",
        "title": "Stop Reading",
        "category": "AI Voice Studio"
      },
      {
        "command": "aiVoiceStudio.setApiKey",
        "title": "Set API Key…",
        "category": "AI Voice Studio"
      },
      {
        "command": "aiVoiceStudio.clearApiKey",
        "title": "Clear API Key…",
        "category": "AI Voice Studio"
      },
      {
        "command": "aiVoiceStudio.focusView",
        "title": "Focus Sidebar",
        "category": "AI Voice Studio"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aiVoiceStudio.quickRead",
          "when": "editorHasSelection",
          "group": "1_modification@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiVoiceStudio.quickRead",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "aiVoiceStudio.stop",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "AI Voice Studio",
      "properties": {
        "aiVoiceStudio.provider": {
          "type": "string",
          "enum": ["openai", "minimax", "mimo"],
          "default": "openai",
          "description": "Active TTS provider."
        },
        "aiVoiceStudio.playbackRate": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4,
          "default": 1,
          "description": "Playback rate (0.5–4.0). Adjusts player speed without re-synthesis."
        },
        "aiVoiceStudio.chunkSize": {
          "type": "number",
          "minimum": 80,
          "maximum": 2000,
          "default": 250,
          "description": "Maximum characters per synthesis chunk. Long text is split at sentence boundaries; the next chunk synthesizes while the current one plays."
        },
        "aiVoiceStudio.openai.model": {
          "type": "string",
          "enum": ["gpt-4o-mini-tts", "tts-1", "tts-1-hd"],
          "enumDescriptions": [
            "GPT-4o Mini TTS — supports speaking instructions",
            "TTS-1 — legacy model, faster",
            "TTS-1 HD — legacy model, higher quality"
          ],
          "default": "gpt-4o-mini-tts",
          "description": "OpenAI text-to-speech model."
        },
        "aiVoiceStudio.openai.voice": {
          "type": "string",
          "default": "cedar",
          "description": "Default OpenAI voice."
        },
        "aiVoiceStudio.openai.format": {
          "type": "string",
          "enum": ["mp3", "wav"],
          "default": "mp3",
          "description": "OpenAI audio response format."
        },
        "aiVoiceStudio.openai.instructions": {
          "type": "string",
          "default": "",
          "description": "Speaking instructions (gpt-4o-mini-tts only). Example: 'Read naturally; preserve Chinese and English pronunciation.'"
        },
        "aiVoiceStudio.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible base URL."
        },
        "aiVoiceStudio.minimax.model": {
          "type": "string",
          "enum": ["speech-2.8-hd", "speech-2.6-hd", "speech-02-hd"],
          "default": "speech-2.8-hd",
          "description": "MiniMax T2A model."
        },
        "aiVoiceStudio.minimax.voice": {
          "type": "string",
          "default": "Chinese (Mandarin)_Radio_Host",
          "description": "Default MiniMax voice ID."
        },
        "aiVoiceStudio.minimax.format": {
          "type": "string",
          "enum": ["mp3", "wav"],
          "default": "mp3",
          "description": "MiniMax audio output format."
        },
        "aiVoiceStudio.minimax.region": {
          "type": "string",
          "enum": ["mainland", "global"],
          "default": "mainland",
          "description": "MiniMax API region (mainland: api.minimaxi.com, global: api.minimax.io)."
        },
        "aiVoiceStudio.minimax.speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "default": 1,
          "description": "MiniMax synthesis speed (0.5–2.0). Server-side; affects pacing/prosody."
        },
        "aiVoiceStudio.minimax.sampleRate": {
          "type": "number",
          "default": 32000,
          "description": "MiniMax audio sample rate (Hz)."
        },
        "aiVoiceStudio.minimax.bitrate": {
          "type": "number",
          "default": 128000,
          "description": "MiniMax audio bitrate."
        },
        "aiVoiceStudio.minimax.languageBoost": {
          "type": "string",
          "default": "",
          "description": "MiniMax language boost hint (e.g. 'Chinese' or 'English'). Optional."
        },
        "aiVoiceStudio.mimo.model": {
          "type": "string",
          "enum": ["mimo-v2.5-tts", "mimo-v2-tts"],
          "default": "mimo-v2.5-tts",
          "description": "MiMo TTS model."
        },
        "aiVoiceStudio.mimo.voice": {
          "type": "string",
          "default": "mimo_default",
          "description": "Default MiMo voice ID."
        },
        "aiVoiceStudio.mimo.format": {
          "type": "string",
          "enum": ["mp3", "wav"],
          "default": "wav",
          "description": "MiMo audio output format."
        },
        "aiVoiceStudio.mimo.baseUrl": {
          "type": "string",
          "default": "https://token-plan-cn.xiaomimimo.com/v1",
          "description": "MiMo Token Plan base URL."
        },
        "aiVoiceStudio.mimo.stylePrompt": {
          "type": "string",
          "default": "",
          "description": "MiMo style prompt prepended as a user message (controls tone/emotion)."
        },
        "aiVoiceStudio.mimo.openingStyleTags": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "MiMo opening style tags injected as a leading prefix (e.g. '开心', '严肃', '兴奋'). The 唱歌 tag overrides others."
        },
        "aiVoiceStudio.mimo.audioEventTags": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "MiMo audio event tags injected as a Chinese-bracket prefix (e.g. '笑声', '叹息')."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.3"
  }
}
